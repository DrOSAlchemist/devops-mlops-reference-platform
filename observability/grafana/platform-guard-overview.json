{
  "id": null,
  "title": "Platform Guard Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Workflow scans per second",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "rate(platform_guard_scan_requests_total[5m])", "legendFormat": "scans/s" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Findings by severity",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "rate(platform_guard_findings_total[5m])", "legendFormat": "{{severity}}" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    }
  ]
}